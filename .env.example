# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser.
# NEVER put the service_role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Store WhatsApp number in international format (no +, no spaces).
# Used as a fallback for the checkout link when store_settings has none.
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=6281234567890

# ── WhatsApp Business API (optional) ─────────────────────────────────────────
# When set, createOrder will push a server-side order notification to
# WHATSAPP_API_NOTIFY_NUMBER via the Meta Cloud API in addition to
# recording the order in the database.
#
# 1. Create a Meta App at developers.facebook.com → WhatsApp → Getting Started
# 2. Copy Phone Number ID and generate a System User access token
# 3. Register your store owner's number as the notification recipient

# Sender phone-number ID from Meta App Dashboard.
WHATSAPP_API_PHONE_NUMBER_ID=

# System User access token with whatsapp_business_messaging permission.
WHATSAPP_API_TOKEN=

# Store owner's WhatsApp number to receive order push notifications (E.164, no +).
WHATSAPP_API_NOTIFY_NUMBER=

# Arbitrary secret used to verify the webhook URL in Meta App Dashboard.
# Register: https://your-domain.com/api/webhook/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# ── Midtrans ──────────────────────────────────────────────────────────────────
# Get keys from: Merchant Portal → Settings → Access Keys
# Sandbox server key starts with SB-Mid-server-…  (server-side only, never expose)
# In production use Wrangler secrets: wrangler secret put MIDTRANS_SERVER_KEY
MIDTRANS_SERVER_KEY=
# Sandbox client key starts with SB-Mid-client-…  (public, baked into bundle)
# Must be hardcoded in next.config.ts for Cloudflare Builds (process.env doesn't work there)
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
# Set to "true" only when using production keys
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION=false
# Server-side only (not NEXT_PUBLIC_) — used by webhook + check-status routes
MIDTRANS_IS_PRODUCTION=false

# ── Resend (email notifications) ─────────────────────────────────────────────
# Sign up at resend.com, verify your sending domain, then create an API key.
# In production use Wrangler secrets: wrangler secret put RESEND_API_KEY
RESEND_API_KEY=
# Verified sender address. Must match a domain verified in Resend.
# In production set in wrangler.jsonc vars.
RESEND_FROM=orders@yourdomain.com
