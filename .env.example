# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — safe to expose to the browser.
# NEVER put the service_role key in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Store WhatsApp number in international format (no +, no spaces).
# Used as a fallback for the checkout link when store_settings has none.
NEXT_PUBLIC_STORE_WHATSAPP_NUMBER=6281234567890
